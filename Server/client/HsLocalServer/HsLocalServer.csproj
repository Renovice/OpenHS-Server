<Project Sdk="Microsoft.NET.Sdk">
  <!-- BepInEx 5 plugin: points the client at the local C# server. Inert unless HS_LOCAL_SERVER=1 (set by run-local.ps1). -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>HsLocalServer</AssemblyName>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameDir>$(MSBuildThisFileDirectory)..\..\..\Hearthstone main game</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameDir)\Hearthstone_Data\Managed\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)\Hearthstone_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(GameDir)\Hearthstone_Data\Managed\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Blizzard.Commerce.Wrapper"><HintPath>$(GameDir)\Hearthstone_Data\Managed\Blizzard.Commerce.Wrapper.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Blizzard.Commerce.Model.CSharp"><HintPath>$(GameDir)\Hearthstone_Data\Managed\Blizzard.Commerce.Model.CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Blizzard.Commerce.Bindings"><HintPath>$(GameDir)\Hearthstone_Data\Managed\Blizzard.Commerce.Bindings.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
