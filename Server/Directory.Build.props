<Project>
  <!-- Shared settings for the private server. The client's protocol assemblies are referenced at compile time
       and resolved from the local game install at runtime (never copied or redistributed). -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The game copy (as HsServer.Protocol.GameFolder): next to Server\ ("Hearthstone main game"), the game folder the repo was
         cloned into (Server\..\..), or the game folder the repo was unpacked into (Server\..). -->
    <HsGameDir Condition="'$(HsGameDir)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hearthstone main game\Hearthstone.exe')">$(MSBuildThisFileDirectory)..\Hearthstone main game</HsGameDir>
    <HsGameDir Condition="'$(HsGameDir)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\Hearthstone.exe')">$(MSBuildThisFileDirectory)..\..</HsGameDir>
    <HsGameDir Condition="'$(HsGameDir)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hearthstone.exe')">$(MSBuildThisFileDirectory)..</HsGameDir>
    <HsGameDir Condition="'$(HsGameDir)' == ''">$(MSBuildThisFileDirectory)..\Hearthstone main game</HsGameDir>
    <HsGameManaged Condition="'$(HsGameManaged)' == ''">$(HsGameDir)\Hearthstone_Data\Managed</HsGameManaged>
    <!-- Referencing .NET Framework-targeted client assemblies from net9.0 is intentional. -->
    <NoWarn>$(NoWarn);MSB3277;NU1701</NoWarn>
  </PropertyGroup>
</Project>
